---
# The search index: every post on the site, as one JSON file fetched by
# assets/search.js the first time someone types in the search bar.
#
# `layout: null` keeps the site chrome out of the output — this file must be
# valid JSON and nothing else.
#
# `body` is capped at 200 words on purpose. It is enough for the search to match
# on what a post is *about* without the index growing by the full text of every
# post; titles, tags and excerpts are indexed whole and carry more weight anyway.
layout: null
permalink: /search.json
---
[
  {%- for post in site.posts -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "datetime": {{ post.date | date_to_xmlschema | jsonify }},
    "tags": [
      {%- for tag in post.tags -%}
      {
        "name": {{ tag | jsonify }},
        "url": {{ tag | slugify | prepend: '/tags/' | append: '/' | relative_url | jsonify }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | strip | jsonify }},
    "body": {{ post.content | strip_html | normalize_whitespace | truncatewords: 200 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
